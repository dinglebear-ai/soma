{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dinglebear.ai/soma/operations/operation-contract.schema.json",
  "title": "Soma Operation Contract Bundle",
  "description": "Canonical operation specifications, Synapse compatibility bindings, and semantic fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_version",
    "generated_at",
    "donor",
    "operations",
    "legacy_bindings",
    "fixtures"
  ],
  "properties": {
    "bundle_version": {
      "$ref": "#/$defs/semver"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "$ref": "#/$defs/text"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "donor": {
      "$ref": "#/$defs/donor"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operationSpec"
      }
    },
    "legacy_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legacyBinding"
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "operationName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*){1,7}$"
    },
    "schemaRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:/#-]+$"
    },
    "targetKind": {
      "enum": [
        "host",
        "docker_engine",
        "container",
        "compose_project",
        "filesystem_path",
        "process",
        "log_source",
        "zfs_pool",
        "zfs_dataset",
        "zfs_snapshot",
        "incus_server",
        "incus_instance",
        "extension"
      ]
    },
    "support": {
      "enum": [
        "required",
        "supported",
        "not_supported"
      ]
    },
    "donor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "operation_count",
        "fixture_digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "operation_count": {
          "type": "integer",
          "minimum": 1
        },
        "fixture_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning",
        "progress",
        "cancellation",
        "verification",
        "fanout"
      ],
      "properties": {
        "planning": {
          "$ref": "#/$defs/support"
        },
        "progress": {
          "$ref": "#/$defs/support"
        },
        "cancellation": {
          "$ref": "#/$defs/support"
        },
        "verification": {
          "$ref": "#/$defs/support"
        },
        "fanout": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "operationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contract_version",
        "summary",
        "domain",
        "target_kind",
        "access",
        "risk",
        "reversibility",
        "retry",
        "idempotency",
        "parameter_schema",
        "result_schema",
        "capabilities",
        "backend_capabilities",
        "evidence_kinds",
        "redaction_profile",
        "implementation_refs",
        "test_refs"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/operationName"
        },
        "contract_version": {
          "$ref": "#/$defs/semver"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "domain": {
          "enum": [
            "ops",
            "fleet",
            "docker",
            "container",
            "compose",
            "host",
            "filesystem",
            "process",
            "logs",
            "zfs",
            "transfer",
            "incus"
          ]
        },
        "target_kind": {
          "$ref": "#/$defs/targetKind"
        },
        "target_resolver": {
          "$ref": "#/$defs/text"
        },
        "access": {
          "enum": [
            "read",
            "mutation"
          ]
        },
        "risk": {
          "enum": [
            "safe",
            "disruptive",
            "destructive",
            "privileged"
          ]
        },
        "reversibility": {
          "enum": [
            "reversible",
            "conditional",
            "irreversible"
          ]
        },
        "retry": {
          "enum": [
            "never",
            "safe",
            "safe_with_idempotency",
            "caller_decides"
          ]
        },
        "idempotency": {
          "enum": [
            "not_applicable",
            "optional",
            "required"
          ]
        },
        "parameter_schema": {
          "$ref": "#/$defs/schemaRef"
        },
        "result_schema": {
          "$ref": "#/$defs/schemaRef"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "backend_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "evidence_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "redaction_profile": {
          "$ref": "#/$defs/text"
        },
        "deprecated": {
          "type": "boolean",
          "default": false
        },
        "implementation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "test_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "legacyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "surface",
        "legacy_name",
        "canonical_name",
        "contract_version",
        "legacy_access",
        "legacy_destructive",
        "transport",
        "parameter_translator",
        "result_projector"
      ],
      "properties": {
        "product": {
          "const": "synapse"
        },
        "surface": {
          "enum": [
            "flux",
            "scout",
            "shared"
          ]
        },
        "legacy_name": {
          "$ref": "#/$defs/text"
        },
        "action": {
          "$ref": "#/$defs/text"
        },
        "subaction": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "canonical_name": {
          "$ref": "#/$defs/operationName"
        },
        "contract_version": {
          "$ref": "#/$defs/semver"
        },
        "legacy_access": {
          "enum": [
            "public",
            "read",
            "write"
          ]
        },
        "legacy_destructive": {
          "type": "boolean"
        },
        "transport": {
          "enum": [
            "rest",
            "mcp_only",
            "both"
          ]
        },
        "required_params": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "required_any": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "parameter_translator": {
          "$ref": "#/$defs/text"
        },
        "result_projector": {
          "$ref": "#/$defs/text"
        },
        "deprecated": {
          "type": "boolean",
          "default": false
        },
        "removal_condition": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_name",
        "contract_version",
        "case_id",
        "kind",
        "input",
        "expected"
      ],
      "properties": {
        "operation_name": {
          "$ref": "#/$defs/operationName"
        },
        "contract_version": {
          "$ref": "#/$defs/semver"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "kind": {
          "enum": [
            "valid_minimal",
            "valid_full",
            "invalid",
            "success",
            "failure",
            "verification",
            "legacy_projection"
          ]
        },
        "input": {},
        "expected": {},
        "expected_diagnostic_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}
